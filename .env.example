# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# Stripe — Developers → API keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...                   # from `stripe listen` or the Dashboard webhook config
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Your deployed site URL (used for Stripe redirect fallback + emails)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
